# Space Exploration Channel - Environment Variables
# Copy to .env and fill in your values

# NASA API (get free key at api.nasa.gov, DEMO_KEY works for testing)
NASA_API_KEY=DEMO_KEY

# OpenAI API (required for scripts, research, titles)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API (required for voiceover)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# YouTube OAuth (download client_secrets.json to config/youtube_client_secrets.json)
# YOUTUBE_CLIENT_SECRETS=config/youtube_client_secrets.json

# Grafana password (for monitoring profile)
GRAFANA_PASSWORD=your_secure_password_here

# Optional: Pexels/Pixabay for additional B-roll
PEXELS_API_KEY=your_pexels_key_here
PIXABAY_API_KEY=your_pixabay_key_here

# Optional: Custom domain for nginx
DOMAIN_NAME=your-domain.com